# Copy this file to .env before starting the stack.
# Replace SERVER_MASTER_KEY with a unique 64+ hex-character secret for any
# non-local use (openssl rand -hex 64), and rotate SEED_ADMIN_PASSWORD.
#
# APP_ENV also drives restricted-share production safety: a production-like
# value (production/staging) marks the sb_share_claim cookie Secure and
# requires an out-of-band OTP dispatcher for require_otp shares (the code is
# never returned in responses). dev/test keep the local conveniences
# (no-Secure cookie over HTTP, OTP echoed in the verify response).
APP_ENV=dev

API_ADDR=:8082
WORKER_ADDR=:8083
SHARE_GATEWAY_ADDR=:8084

# Host ports the compose `edge` service publishes for TLS + HTTP
# redirect. Override when the defaults clash with something already
# bound on the host (common on dev laptops where :8080 is taken).
EDGE_HTTPS_PORT=8443
EDGE_HTTP_PORT=8088

DATABASE_URL=postgres://postgres:postgres@postgres:5432/storage_boxes?sslmode=disable

# 64-hex chars (32 bytes). Required when APP_ENV is production or staging.
SERVER_MASTER_KEY=

# Vault blob storage and share stage storage. Kept separate so a share
# purge never touches vault contents.
BOX_STORAGE_ROOT=/data/boxes
SHARE_STAGE_ROOT=/data/shares

# External URL the api returns in share-create responses; the share-gateway
# serves the matching /s/{token} path. Leave empty for relative URLs.
SHARE_PUBLIC_BASE_URL=

# Restricted-share OTP delivery (require_otp). Set ADDR + FROM to enable the
# bundled email dispatcher; the one-time code is emailed to the recipient
# out-of-band (never returned in a response or logged). Leave empty in dev:
# APP_ENV=dev echoes the code in the verify response for local testing, and a
# production-like APP_ENV without these set rejects require_otp shares at
# create time. USERNAME/PASSWORD enable SMTP PLAIN auth over STARTTLS.
SHARE_OTP_SMTP_ADDR=
SHARE_OTP_SMTP_FROM=
SHARE_OTP_SMTP_USERNAME=
SHARE_OTP_SMTP_PASSWORD=

# How long a pending owner-approved access request stays open before the
# worker's AccessRequestCleanupJob expires it. Go duration; default 168h
# (7 days). Set on the api + share-gateway (which stamp expires_at at
# submission time); the worker reads the stamp.
SHARE_ACCESS_REQUEST_TTL=168h

# Comma-separated CIDRs/IPs trusted to set X-Forwarded-For on the api
# and share-gateway. Populate with the edge service's private IP range.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Worker job intervals. Tune per deployment.
WORKER_SWEEP_INTERVAL=5m
WORKER_SHARE_INTERVAL=1m
WORKER_OUTBOX_INTERVAL=15s

# Bootstrap administrator. The API reapplies the password on startup.
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=admin-dev-password-change-me
SEED_ADMIN_DISPLAY_NAME=Administrator
